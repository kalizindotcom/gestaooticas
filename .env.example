# API do frontend. Deixe vazio para usar http://localhost:3001/api em desenvolvimento
# e /api em produção no mesmo domínio.
VITE_API_URL=

# Servidor local
PORT=3001

# Gere uma chave aleatória com pelo menos 32 caracteres. Nunca use um valor padrão.
LOCAL_AUTH_SECRET=
# Use o seed somente no primeiro boot e remova/desative depois da criação do administrador.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_SEED_ADMIN=false
# Em produção, informe as origens HTTPS separadas por vírgula.
CORS_ORIGINS=https://gestaooticas.online
# O cadastro inicial público fica desativado por padrão em produção.
ALLOW_INITIAL_SIGNUP=false
# Em desenvolvimento, o token de reset pode ser retornado para a tela local.
ALLOW_LOCAL_RESET_TOKEN=true
